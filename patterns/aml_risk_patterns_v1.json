  "patterns": [
    {
      "pattern_id": "AML-V1-01-RAPID-PASS-THROUGH",
      "risk_type": "RAPID_PASS_THROUGH",
      "description": "账户收款后在较短时间内转出与入账金额大体相当的资金，形成低留存的过渡账户行为。",
      "version": "1.0",
      "clauses": [
        {
          "clause_id": "incoming",
          "action_type": "TRANSFER",
          "anchor_role": "receiver",
          "min_count": 1
        },
        {
          "clause_id": "outgoing",
          "action_type": "TRANSFER",
          "anchor_role": "sender",
          "min_count": 1
        }
      ],
      "constraints": [
        {
          "constraint_type": "ordered_within",
          "parameters": {
            "earlier": "incoming",
            "later": "outgoing",
            "min_seconds": 1,
            "max_seconds": 86400
          }
        },
        {
          "constraint_type": "sum_ratio",
          "parameters": {
            "numerator": "outgoing",
            "denominator": "incoming",
            "attribute": "amount",
            "minimum": 0.8,
            "maximum": 1.2
          }
        }
      ],
      "quality": {
        "source": "expert_literature_synthesis",
        "confidence_status": "uncalibrated"
      },
      "provenance": {
        "source_ids": ["AUSTRAC-BANKING-INDICATORS", "FATF-EGMONT-TBML-2021"],
        "source_indicator": "rapid movement through accounts and pass-through activity with a small residual balance",
        "research_defaults": {
          "window_seconds": 86400,
          "outgoing_incoming_ratio": [0.8, 1.2]
        },
        "required_fields": ["timestamp", "sender", "receiver", "amount"],
        "false_positive_notes": "工资代发、内部归集、证券结算和商户清算可能产生相似结构。"
      }
    },
    {
      "pattern_id": "AML-V1-02-MULTI-SOURCE-CONCENTRATION",
